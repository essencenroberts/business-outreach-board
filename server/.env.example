# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/business-outreach-board?retryWrites=true&w=majority

# Your single admin login
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Frontend URL(s) allowed to call the API (comma-separated). Hostnames without https:// are fine.
CLIENT_ORIGIN=http://localhost:5173

# Optional: enables the Claude features (Find leads, AI quick-add, AI audit)
ANTHROPIC_API_KEY=
# Optional: override the Claude model
CLAUDE_MODEL=claude-opus-5-5

PORT=4000
